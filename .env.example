# MongoDB Atlas connection string (required)
# Code reads MONGO_URI (not MONGODB_URI)
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/rua_sadiq?retryWrites=true&w=majority

# JWT signing secret — change in production
JWT_SECRET=rua_sadiq_jwt_secret_change_me_in_production_2024

# Admin credentials (used by /api/admin/login + create-admin script)
ADMIN_USERNAME=admin123@gmail.com
ADMIN_PASSWORD=1234567890

# Optional: comma-separated origins for CORS (defaults to * in middleware)
# FRONTEND_ORIGIN=https://ruasadiq.com,https://www.ruasadiq.com,http://localhost:5173

PORT=5000
